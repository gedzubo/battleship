<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Settings</h1>

  <section class="mt-8">
    <h2 class="font-semibold text-xl mb-4">Username</h2>
    <%= form_with url: settings_path, method: :patch, class: "contents" do |form| %>
      <%= form.hidden_field :change, value: "username" %>
      <div class="my-5">
        <%= form.text_field :username, value: Current.user.username, autocomplete: "username", placeholder: "Choose a username (optional)", name: "user[username]", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <%= form.submit "Update username", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <% end %>
  </section>

  <hr class="my-8 border-gray-200">

  <section>
    <h2 class="font-semibold text-xl mb-4">Change password</h2>
    <%= form_with url: settings_path, method: :patch, class: "contents" do |form| %>
      <%= form.hidden_field :change, value: "password" %>
      <div class="my-5">
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", placeholder: "Current password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="my-5">
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "New password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="my-5">
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm new password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <%= form.submit "Update password", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <% end %>
  </section>
</div>
