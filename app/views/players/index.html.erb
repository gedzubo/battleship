<%= turbo_stream_from "players" %>

<div class="w-full max-w-lg">
  <h1 class="text-2xl font-bold mb-6">Players</h1>

  <% if @players.any? %>
    <ul class="divide-y divide-gray-200 border border-gray-200 rounded-lg">
      <% @players.each do |player| %>
        <li class="flex items-center justify-between px-4 py-3">
          <span class="text-sm font-medium text-gray-900"><%= player.email_address %></span>
          <%= render "player_presence", player: player %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-500">No other players have registered yet.</p>
  <% end %>
</div>
