<span id="<%= dom_id(player, :presence) %>">
  <% if player.online? %>
    <span class="inline-block w-2 h-2 rounded-full bg-green-500" title="Online"></span>
    <span class="text-xs text-green-600">Online</span>
  <% else %>
    <span class="inline-block w-2 h-2 rounded-full bg-gray-300" title="Offline"></span>
    <span class="text-xs text-gray-400">Offline</span>
  <% end %>
</span>
